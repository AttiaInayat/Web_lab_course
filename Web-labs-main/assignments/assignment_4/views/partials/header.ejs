<header>
  <!-- Top Header -->
  <div class="container py-3">
    <div class="row align-items-center">
      <!-- Logo -->
      <div class="col-2 col-md-2 logo d-flex align-items-center">
        <img
          src="/images/logo.webp"
          alt="Oasis Logo"
          class="img-fluid logo-img"
        />
      </div>
      <!-- Search Container -->
      <div class="col-8 col-md-7">
        <div class="search-container d-flex align-items-center">
          <input
            type="search"
            placeholder="Search Products and Brands"
            class="form-control border-0 shadow-none"
          />
          <img src="/images/search.svg" alt="Search Icon" />
        </div>
      </div>
      <!-- Icons -->
      <div
        class="col-2 col-md-3 iconshead d-flex justify-content-end align-items-center gap-3"
      >
        <img src="/images/user (1).svg" alt="User Icon" width="24" />
        <img src="/images/heart.svg" alt="Favourite Icon" width="24" />
        <img
          src="/images/shopping-bag.svg"
          alt="Shopping Bag Icon"
          width="24"
        />
      </div>
    </div>
  </div>
  <!-- Navigation Menu -->
  <div class="bg-light">
    <div class="container menu-head">
      <nav>
        <ul class="nav justify-content-center flex-nowrap">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item">
            <a class="nav-link" href="/products">Products</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/about">About</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/cart">Cart</a>
          </li>

          <% if (session && session.user) { %> <% if (session.user.email ===
          'admin@project.com') { %>
          <!-- Admin Links -->
          <li class="nav-item">
            <a class="nav-link" href="/admin">Admin</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/complaints/admin/complaints"
              >View All Complaints</a
            >
          </li>
          <% } else { %>
          <!-- Regular User Links -->
          <li class="nav-item">
            <a class="nav-link" href="/my_orders">My Orders</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/complaints/contact">Contact Us</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/complaints/my-complaints"
              >My Complaints</a
            >
          </li>
          <% } %> <% } %> <% if(!session.user) { %>
          <li class="nav-item">
            <a class="nav-link" href="/auth/login">Login</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/auth/register">Register</a>
          </li>

          <% } else { %>

          <li class="nav-item">
            <a class="nav-link" href="/auth/logout">Logout</a>
          </li>
          <% } %>
        </ul>
      </nav>
    </div>
  </div>
  <!-- Marquee -->
  <div class="marquee-container bg-light py-2">
    <div class="container">
      <div class="marquee-content">
        <a href="#"
          >Step Into Spring With 30% Off New Season Wardrobe | Shop Offer</a
        >
        <a href="#"
          >Extra 20% Off All Oasis | Code: EXTRA20 Shop Oasis00:07:27:47</a
        >
        <a href="#">Up To 50% Off Oasis | Shop Offer</a>
        <a href="#">Scene Stealing Styles | Shop Occasion</a>
      </div>
    </div>
  </div>
</header>

<div class="blacktab text-center">
  <a href="#">Unlimited Next Day Delivery £14.99 | Shop Now</a>
</div>
